# Environment Variables — Copy this to .env and fill in values
# Never commit .env to Git

# Database
DATABASE_URL=sqlite:///./data/billiard.db

# Security
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_STRING

# Application
DEBUG=false
ENVIRONMENT=production

# CORS — Frontend URL
ALLOWED_ORIGINS=http://localhost:5173

# Backup
BACKUP_DIR=./backups
